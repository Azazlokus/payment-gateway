APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
ADMINER_PORT=8080
FRONTEND_PORT=3080

# ─── Платёжные провайдеры ──────────────────────────────────────────────────────

PAYMENT_PROVIDER=yookassa

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true

# СБП (через банк-эквайер с НСПК-совместимым API)
SBP_MERCHANT_ID=
SBP_API_KEY=
SBP_WEBHOOK_SECRET=
SBP_BASE_URL=https://api.nspk.ru/sbp/v1/merchant-integrations

# Альфа-Банк интернет-эквайринг
ALFABANK_LOGIN=
ALFABANK_PASSWORD=
# Тест: https://alfa.rbsuat.com/payment/rest
# Прод: https://pay.alfabank.ru/payment/rest
ALFABANK_BASE_URL=https://alfa.rbsuat.com/payment/rest
ALFABANK_IS_TEST=true

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ─── Антифрод & Circuit Breaker ────────────────────────────────────────────────

ANTIFRAUD_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# ─── Outbound notifications (HMAC-SHA256 signing key) ──────────────────────────

NOTIFICATION_SECRET=

# ─── Общие настройки ──────────────────────────────────────────────────────────

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── База данных ──────────────────────────────────────────────────────────────

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=payment_gateway
DB_USERNAME=postgres
DB_PASSWORD=secret

# ─── Сессии ───────────────────────────────────────────────────────────────────

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Очереди, кэш, файлы ─────────────────────────────────────────────────────

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Horizon (очереди) ────────────────────────────────────────────────────────

HORIZON_PATH=horizon
HORIZON_ALLOWED_IPS=

# ─── Уведомления (Slack) ─────────────────────────────────────────────────────

SLACK_WEBHOOK_URL=

# ─── Sentry — трекинг ошибок (https://sentry.io) ─────────────────────────────

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Grafana ──────────────────────────────────────────────────────────────────

GRAFANA_USER=admin
GRAFANA_PASSWORD=secret

# ─── Почта ────────────────────────────────────────────────────────────────────

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ─── AWS (S3, если нужно) ────────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Frontend ─────────────────────────────────────────────────────────────────

VITE_APP_NAME="${APP_NAME}"

# ─── ELK Stack (requires --profile elk) ──────────────────────────────────────

LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_PORT=9200
KIBANA_PORT=5601
LOG_PAYMENTS_STACK=payments_file
# To enable ELK shipping: LOG_PAYMENTS_STACK=payments_file,logstash

# ─── Крипто-депозиты ─────────────────────────────────────────────────────────

# Время жизни депозита в минутах (по умолчанию 20)
CRYPTO_DEPOSIT_TTL_MINUTES=20

# TON / USDT-TON (через TonCenter API, бесплатно)
TON_MASTER_ADDRESS=              # Единый адрес для приёма TON и USDT-TON
TON_API_KEY=                     # Ключ toncenter.com (бесплатный tier: 1 req/s)
TON_API_URL=https://toncenter.com/api/v2
TON_API_V3_URL=https://toncenter.com/api/v3
TON_USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_HOT_WALLET_MNEMONIC=

# Bitcoin (через mempool.space, полностью бесплатно, без ключа)
BTC_DEPOSIT_ADDRESSES=           # пример: bc1q...,bc1q...
BTC_API_URL=https://mempool.space/api

# TRON / USDT-TRC20 (через TronGrid, бесплатно, ключ опционален)
TRON_DEPOSIT_ADDRESSES=          # пример: T...,T...
TRON_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=                # Бесплатный ключ с trongrid.io (увеличивает лимиты)
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_HOT_WALLET_PRIVATE_KEY=
